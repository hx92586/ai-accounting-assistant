# Local quick start. PostgreSQL is also supported through postgresql+psycopg://...
DATABASE_URL=sqlite:///./accounting.db
# Generate a value with: python -c "import secrets; print(secrets.token_urlsafe(48))"
SECRET_KEY=
# Optional: required only for AI chat; never put this value in frontend configuration.
DASHSCOPE_API_KEY=
DASHSCOPE_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1
QWEN_MODEL=qwen-plus
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
